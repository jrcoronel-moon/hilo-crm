# Hilo CRM configuration. Copy to .env and fill in. NEVER commit .env.
# Generate every secret with:   openssl rand -base64 48 | tr -d '/+=' | cut -c1-48

# ── Public address ──
# Local: http://localhost:8080   Production: https://crm.example.com
APP_BASE_URL=http://localhost:8080
# Local only: host port Caddy publishes on 127.0.0.1 (keep APP_BASE_URL in sync).
HILO_HTTP_PORT=8080
# Caddy site: ":8080" locally; the bare hostname in production (crm.example.com).
SITE_ADDRESS=:8080
# Let's Encrypt contact (production only).
ACME_EMAIL=

# ── Secrets (all required) ──
SESSION_SECRET=
POSTGRES_PASSWORD=
HILO_MIGRATOR_PASSWORD=
HILO_APP_PASSWORD=

# ── Sign-in providers (at least one in production) ──
# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth client (Web)
#   Authorized redirect URI: <APP_BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft: entra.microsoft.com → App registrations → New (accounts in any org + personal)
#   Redirect URI (Web): <APP_BASE_URL>/auth/microsoft/callback
#   Token configuration → add optional claims "email" and "xms_edov" (ID token).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# ── Access ──
# Promoted to superadmin on sign-in (comma separated).
SUPERADMIN_EMAILS=
# Local development only: password-less login form. Refused unless APP_BASE_URL is localhost.
DEV_LOGIN_ENABLED=false

# ── Optional ──
BACKUP_KEEP_DAYS=14
# Set to 1 to print the startup banner without colours (CloudWatch & co.).
NO_COLOR=
